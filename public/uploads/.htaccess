# Каталог пользовательских загрузок — только отдача статики, без исполнения кода.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
